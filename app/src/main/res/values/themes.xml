<resources>
    <!-- Startup screen: background matches the logo's black so the logo looks like it floats on it.
         To use grey instead, change @color/splash in colors.xml (e.g. #2E2E2E). -->
    <style name="Theme.Vaux.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Vaux</item>
    </style>
    <style name="Theme.Vaux" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
